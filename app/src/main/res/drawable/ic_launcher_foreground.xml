<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Vertical Bar of the Cross with Gradient Fill -->
    <path
        android:pathData="M 51,28 h 6 a 6,6 0 0 1 6,6 v 40 a 6,6 0 0 1 -6,6 h -6 a 6,6 0 0 1 -6,-6 v -40 a 6,6 0 0 1 6,-6 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#006D6F" />
                <item android:offset="0.5" android:color="#00BCD4" />
                <item android:offset="1.0" android:color="#3F51B5" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Horizontal Bar of the Cross with Gradient Fill -->
    <path
        android:pathData="M 34,45 h 40 a 6,6 0 0 1 6,6 v 6 a 6,6 0 0 1 -6,6 h -40 a 6,6 0 0 1 -6,-6 v -6 a 6,6 0 0 1 6,-6 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#006D6F" />
                <item android:offset="0.5" android:color="#00BCD4" />
                <item android:offset="1.0" android:color="#3F51B5" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Checkmark: Soft Neon Underlay -->
    <path
        android:pathData="M 42,52 L 51,61 L 68,42"
        android:strokeColor="#6600BCD4"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Glowing Checkmark: Solid White Core -->
    <path
        android:pathData="M 42,52 L 51,61 L 68,42"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>